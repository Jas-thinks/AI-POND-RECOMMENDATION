# AI-Based Village Pond Planning System Configuration

# FastAPI application configurations
APP_ENV=development
APP_PORT=8000

# USER CONFIGURATION REQUIRED: Custom User-Agent for Nominatim geocoding (to prevent rate-limiting)
GEOCONTROLLER_USER_AGENT=AI-VillagePondPlanner/1.0 (contact: user@example.com)

# Open-Meteo API (no key required, but can be configured)
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1

# OpenStreetMap / Overpass hard-exclusion land data.
# All of these are OPTIONAL: sensible defaults are built in, so the
# application works locally without setting any of them. Override on a
# stateless host (e.g. Render) if the defaults need tuning.
#
# Primary Overpass interpreter endpoint (default: overpass-api.de).
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# Comma-separated fallback endpoints. When unset, the built-in defaults
# (overpass.kumi.systems, overpass.private.coffee) are used.
# OVERPASS_FALLBACK_URLS=https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
# Server-side Overpass QL query timeout in seconds ([timeout:N]).
# OVERPASS_TIMEOUT=60
# Per-phase HTTP timeouts in seconds. OVERPASS_READ_TIMEOUT must exceed
# OVERPASS_TIMEOUT so a slow (but working) server is not aborted early.
# OVERPASS_CONNECT_TIMEOUT=10
# OVERPASS_READ_TIMEOUT=90
# Total attempts (first try + retries); retries are always bounded.
# OVERPASS_MAX_RETRIES=3
# Exponential backoff base in seconds (delays: base, 2*base, 4*base...).
# OVERPASS_BACKOFF_BASE=2
